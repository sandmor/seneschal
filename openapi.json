                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDirectoryRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": ["path"],
        "title": "CreateDirectoryRequest"
      },
      "CreateDocumentRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "default": ""
          }
        },
        "type": "object",
        "required": ["path"],
        "title": "CreateDocumentRequest"
      },
      "DirectoryNodeResponse": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "directory",
            "title": "Kind",
            "default": "directory"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Path"
          },
          "child_directories_count": {
            "type": "integer",
            "title": "Child Directories Count"
          },
          "child_documents_count": {
            "type": "integer",
            "title": "Child Documents Count"
          }
        },
        "type": "object",
        "required": [
          "path",
          "name",
          "parent_path",
          "child_directories_count",
          "child_documents_count"
        ],
        "title": "DirectoryNodeResponse"
      },
      "DirectoryResponse": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "directory",
            "title": "Kind",
            "default": "directory"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Path"
          },
          "child_directories_count": {
            "type": "integer",
            "title": "Child Directories Count"
          },
          "child_documents_count": {
            "type": "integer",
            "title": "Child Documents Count"
          },
          "children": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/DirectoryNodeResponse"
                },
                {
                  "$ref": "#/components/schemas/DocumentNodeResponse"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "directory": "#/components/schemas/DirectoryNodeResponse",
                  "document": "#/components/schemas/DocumentNodeResponse"
                }
              }
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "path",
          "name",
          "parent_path",
          "child_directories_count",
          "child_documents_count",
          "children"
        ],
        "title": "DirectoryResponse"
      },
      "DocumentNodeResponse": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "document",
            "title": "Kind",
            "default": "document"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent_path": {
            "type": "string",
            "title": "Parent Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          }
        },
        "type": "object",
        "required": ["path", "name", "parent_path", "size_bytes"],
        "title": "DocumentNodeResponse"
      },
      "DocumentResponse": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "document",
            "title": "Kind",
            "default": "document"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent_path": {
            "type": "string",
            "title": "Parent Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": ["path", "name", "parent_path", "size_bytes", "content"],
        "title": "DocumentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "UpdateDirectoryRequest": {
        "properties": {
          "new_path": {
            "type": "string",
            "title": "New Path"
          }
        },
        "type": "object",
        "required": ["new_path"],
        "title": "UpdateDirectoryRequest"
      },
      "UpdateDocumentRequest": {
        "properties": {
          "new_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "New Path"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "type": "object",
        "title": "UpdateDocumentRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
