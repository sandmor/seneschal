          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["documents"],
        "summary": "Create Document",
        "operationId": "create_document_api_documents_post",
        "requestBody": {
          "required": true,
