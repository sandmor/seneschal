# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Frontend URL (For FastAPI CORS)
PUBLIC_FRONTEND_URL=http://localhost:3000

# Used by the browser (Client-side) to reach the backend
VITE_PUBLIC_API_URL=http://localhost:8000
# Used by the SSR server (inside Docker) to reach the backend
INTERNAL_API_URL=http://backend:8000
