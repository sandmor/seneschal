{
  "name": "seneschal",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build:frontend": "bun run --cwd frontend build",
    "dev": "bun run ./scripts/dev.ts all",
    "dev:backend": "bun run ./scripts/dev.ts backend",
    "dev:frontend": "bun run ./scripts/dev.ts frontend",
    "format": "bun run format:py && bun run format:web",
    "format:check": "bun run format:check:py && bun run format:check:web",
    "format:py": "uv run ruff format backend",
    "format:check:py": "uv run ruff format --check backend",
    "format:web": "prettier --write . --ignore-unknown",
    "format:check:web": "prettier --check . --ignore-unknown",
    "lint": "bun run lint:files && bun run lint:py && bun run lint:frontend && bun run typecheck:scripts",
    "lint:files": "ls-lint",
    "lint:py": "uv run ruff check backend",
    "lint:frontend": "bun run orval && bun run --cwd frontend lint && bun run --cwd frontend typecheck",
    "orval": "bun run ./scripts/orval.ts",
    "smoke": "bun run ./scripts/smoke.ts local",
    "smoke:docker": "bun run ./scripts/smoke.ts docker",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
